DATABASE_URL=postgresql+asyncpg://user:password@db:5432/storm

JWT_SECRET_KEY=change_me_please_with_very_long_secret_key
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=storm-files
MINIO_USE_SSL=false

BACKEND_CORS_ORIGINS=https://localhost:3000,https://127.0.0.1:3000
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEBUG=false

COOKIE_SECURE=true
COOKIE_SAMESITE=strict
CSRF_ALLOWED_ORIGINS=https://localhost:3000,https://127.0.0.1:3000

# --- SSO / OIDC (корпоративная IAM, Keycloak-совместимый провайдер) ---
# Включает кнопку «Войти через SSO» и маршруты /api/v1/auth/sso/*.
# Поток: OpenID Connect Authorization Code + PKCE. Пусто/false — вход только по логину-паролю.
SSO_ENABLED=false
# issuer провайдера. Discovery ищется по {issuer}/.well-known/openid-configuration.
# Для Keycloak обычно: https://<keycloak-host>/realms/<realm>
# SSO_ISSUER=https://iam.example.com/realms/storm
# Либо полный discovery-URL (переопределяет вывод из issuer):
# SSO_METADATA_URL=https://iam.example.com/realms/storm/.well-known/openid-configuration
# SSO_CLIENT_ID=storm
# SSO_CLIENT_SECRET=<секрет клиента; пусто = публичный клиент, только PKCE>
# Запрашиваемые у IdP scope (через пробел). По умолчанию — профиль и email пользователя.
# SSO_SCOPES=openid profile email
# Абсолютный публичный адрес приложения для redirect_uri. Пусто — берётся APP_BASE_URL.
# В клиенте IdP должен быть разрешён Valid Redirect URI:
#   {SSO_REDIRECT_BASE|APP_BASE_URL}/api/v1/auth/sso/callback
# SSO_REDIRECT_BASE=https://localhost:3000
# Claim'ы ID-токена, из которых берём username и email.
# SSO_USERNAME_CLAIM=preferred_username
# SSO_EMAIL_CLAIM=email
# Создавать локального пользователя при первом входе через SSO (true/false).
# SSO_AUTO_CREATE_USERS=true
# Роль автосоздаваемого пользователя: pentester | admin.
# SSO_DEFAULT_ROLE=pentester
# Надпись на кнопке входа.
# SSO_BUTTON_LABEL=Войти через SSO
# TLS к IdP: true — системный бандл; false — не проверять (только тест);
# путь — PEM-файл с CA внутреннего удостоверяющего центра.
# SSO_VERIFY_TLS=true

INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@local
INITIAL_ADMIN_PASSWORD=admin

RABBITMQ_URL=amqp://guest:guest@rabbitmq/
MAIL_QUEUE_NAME=storm.mail
MAIL_ENABLED=false
MAIL_MAX_ATTEMPTS=5

# ──────────────── Рекон-ферма (пробив списков хостов и IP) ────────────────
# Прогонять задачи через RabbitMQ и контейнер recon-worker (docker-compose).
# false — прогон в процессе API через BackgroundTasks: для разработки без RabbitMQ.
RECON_WORKER_ENABLED=true
RECON_QUEUE_NAME=recon
RECON_MAX_ATTEMPTS=3
# Обратный резолв (PTR + forward-confirm) при импорте IP. На изолированном
# стенде без DNS выключите, иначе каждый адрес будет ждать таймаута.
FARM_REVERSE_DNS_ENABLED=true
FARM_REVERSE_DNS_TIMEOUT_SECONDS=3.0
# Ферма ходит только во внешнюю сеть (SSRF-guard). Включать осознанно.
FARM_ALLOW_PRIVATE_TARGETS=false
# Импорт IP: подтверждённые PTR-имена адреса прогонять фермой хостов (искать их
# веб-порты и сервисы) и заводить полноценным хостом.
FARM_IP_RESOLVE_HOSTS_ENABLED=true
# Определение технологий и CDN веб-порта при пробиве (сервисы + флаг Cloudflare).
# Выключите, если инструменты не установлены, — порты останутся «unknown».
SERVICES_DETECT_ENABLED=true
# Движок: httpx (ProjectDiscovery, быстрее/точнее) | whatweb (запасной).
SERVICES_DETECT_ENGINE=httpx
SERVICES_DETECT_TIMEOUT_SECONDS=20.0

# ──────────────── SMTP ────────────────
# Способ аутентификации: "password" (обычный SMTP AUTH) или "xoauth2" (OAuth2, профиль 4).
SMTP_AUTH_METHOD=password
#
# Поддерживаются 4 профиля. Раскомментируйте нужный, остальные оставьте закомментированными.
# SMTP_USE_TLS=true  — STARTTLS (порт 587, Gmail/корпоративные)
# SMTP_USE_SSL=true  — implicit SSL (порт 465)
# Оба false        — открытый SMTP (только локально, например mailpit)

# ── По умолчанию почта ВЫКЛЮЧЕНА (MAIL_ENABLED=false выше) — локальный mailpit
# из проекта убран. Приглашения всё равно создаются: ссылка активации
# возвращается администратору в ответе API. Для реальной отправки писем
# поставьте MAIL_ENABLED=true и раскомментируйте ОДИН из профилей ниже.
SMTP_FROM_EMAIL=storm-noreply@sbertech.ru
SMTP_FROM_NAME=STORM
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false

# ── 2) Тестовая отправка через Gmail
# Для Gmail нужен «App password» (требует 2FA на аккаунте):
#   Google Account → Security → 2-Step Verification → App passwords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-account@gmail.com
# SMTP_PASSWORD=xxxx xxxx xxxx xxxx
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false
# SMTP_FROM_EMAIL=your-account@gmail.com
# SMTP_FROM_NAME=STORM

# ── 3) Корпоративная учётка @sbertech (продакшен)
# Реальные хост/порт уточняются у админов почты, ниже — типовой шаблон.
# SMTP_HOST=smtp.sbertech.ru
# SMTP_PORT=587
# SMTP_USERNAME=storm-noreply@sbertech.ru
# SMTP_PASSWORD=<секрет из vault>
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false
# SMTP_FROM_EMAIL=storm-noreply@sbertech.ru
# SMTP_FROM_NAME=STORM

# ── 4) Отправка от лица Gmail-аккаунта через OAuth2 (XOAUTH2)
# В отличие от профиля 2, не требует App Password — доступ выдаётся через
# экран согласия Google. Порядок настройки:
#   1) Google Cloud Console: OAuth client типа «Web», в Authorized redirect URIs
#      добавить  http://localhost:8765/oauth2callback
#   2) Заполнить GOOGLE_OAUTH_CLIENT_ID / GOOGLE_OAUTH_CLIENT_SECRET ниже
#   3) python backend/scripts/google_oauth_setup.py  → получить refresh token
#   4) Вставить GOOGLE_OAUTH_REFRESH_TOKEN и раскомментировать блок ниже
# SMTP_AUTH_METHOD=xoauth2
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false
# SMTP_USERNAME=your-account@gmail.com
# SMTP_FROM_EMAIL=your-account@gmail.com
# SMTP_FROM_NAME=STORM
# GOOGLE_OAUTH_CLIENT_ID=xxxxx.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-xxxxx
# GOOGLE_OAUTH_REFRESH_TOKEN=1//xxxxx

# ── 5) Microsoft Exchange ЛОКАЛЬНЫЙ (on-prem Exchange Server): обычный SMTP-сабмит
# по 587 + STARTTLS и basic-аутентификация (доменная учётка). Отдельного OAuth не
# нужно — работает профиль "password".
# SMTP_AUTH_METHOD=password
# SMTP_HOST=mail.corp.local          # FQDN сервера Exchange / CAS
# SMTP_PORT=587
# SMTP_USE_TLS=true                  # STARTTLS
# SMTP_USE_SSL=false
# SMTP_USERNAME=STORM-noreply@corp.local   # или DOMAIN\\username
# SMTP_PASSWORD=<секрет из vault>
# SMTP_FROM_EMAIL=STORM-noreply@corp.local
# SMTP_FROM_NAME=STORM

# ── 6) Microsoft 365 / Exchange Online через OAuth2 (XOAUTH2, Modern Auth)
# Basic-аутентификация в Exchange Online отключена — нужен токен Azure AD.
# App-only (client credentials) — проще всего для сервисной учётки:
#   1) Azure Portal → App registrations → новое приложение, создать client secret.
#   2) API permissions → Office 365 Exchange Online → Application → SMTP.SendAsApp,
#      выдать admin consent.
#   3) В Exchange Online разрешить приложению слать от нужного ящика
#      (New-ServicePrincipal + Add-MailboxPermission / политика).
# SMTP_AUTH_METHOD=xoauth2
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false
# SMTP_USERNAME=storm-noreply@your-tenant.onmicrosoft.com   # адрес почтового ящика
# SMTP_FROM_EMAIL=storm-noreply@your-tenant.onmicrosoft.com
# SMTP_FROM_NAME=STORM
# SMTP_OAUTH_TOKEN_URL=https://login.microsoftonline.com/<tenant-id>/oauth2/v2.0/token
# SMTP_OAUTH_CLIENT_ID=<application (client) id>
# SMTP_OAUTH_CLIENT_SECRET=<client secret>
# SMTP_OAUTH_GRANT_TYPE=client_credentials
# SMTP_OAUTH_SCOPE=https://outlook.office365.com/.default
# (Делегированный доступ вместо app-only: SMTP_OAUTH_GRANT_TYPE=refresh_token,
#  SMTP_OAUTH_REFRESH_TOKEN=<...>, SMTP_OAUTH_SCOPE=https://outlook.office365.com/SMTP.Send offline_access)

# URL веб-интерфейса для просмотра писем (MAIL_PREVIEW_URL). Пусто по умолчанию.
# MAIL_PREVIEW_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Jira — интеграция (экспорт уязвимости в issue + раздел «Tasks»)
# ─────────────────────────────────────────────────────────────────────────────
# Подключение, версия API, тип аутентификации И ПУТИ эндпоинтов вынесены в env —
# чтобы подключить инстанс Jira с немного другим API без правки кода.
# Пусто BASE_URL/TOKEN → интеграция считается ненастроенной (UI покажет это явно).
# JIRA_BASE_URL=https://jira.example.com
# JIRA_API_TOKEN=<api-token (Cloud) или PAT (Server/DC)>
# JIRA_EMAIL=you@org.com                 # нужен для basic-аутентификации (Cloud)
# JIRA_ENABLED=true
#
# Проект раздела «Tasks» (read-only витрина задач). По умолчанию STS.
# JIRA_TASKS_PROJECT_KEY=STS
# Проект для экспорта уязвимостей (если отличается).
# JIRA_DEFAULT_PROJECT_KEY=SEC
# JIRA_DEFAULT_ISSUE_TYPE=Task
#
# Версия REST API, тип аутентификации и эндпоинты. {version} и {key} подставляются.
# Значения по умолчанию = Jira Cloud (v3). Для Jira Server/DC типично:
#   JIRA_API_VERSION=2
#   JIRA_AUTH_TYPE=bearer
#   JIRA_SEARCH_PATH=/rest/api/{version}/search
#   JIRA_SEARCH_METHOD=POST
# JIRA_API_VERSION=3
# JIRA_AUTH_TYPE=basic                   # basic (email+token) | bearer (PAT)
# JIRA_SEARCH_PATH=/rest/api/{version}/search/jql
# JIRA_SEARCH_METHOD=GET                 # GET (Cloud /search/jql) | POST (/search)
# JIRA_ISSUE_PATH=/rest/api/{version}/issue/{key}
# JIRA_CREATE_ISSUE_PATH=/rest/api/{version}/issue
# Человекочитаемая ссылка на задачу в Task Tracker (Works). По умолчанию —
# формат пространства STS (AppSec); base берётся из JIRA_BASE_URL.
# JIRA_BROWSE_PATH=/swtr/units/current/unit/{key}?space=STS&tenant=default

# ─────────────────────────────────────────────────────────────────────────────
# Works (SberTrack / AppSec) — экспорт устранения уязвимости в пространство STS
# ─────────────────────────────────────────────────────────────────────────────
# Создаёт тикет BUG_APPSEC в Works + резолвит компонент/версию (typeahead) и
# подтягивает статус тикета. Авторизация: Bearer-токен сервисной учётки Works +
# статическая cookie + заголовок Origin (хост без /swtr). Пусто TOKEN / ENABLED=false
# → раздел экспорта в AppSec и дропдаун версии недоступны (UI покажет это).
# WORKS_ENABLED=true
# WORKS_BASE_URL=https://portal.works.prod.sbt/swtr
# WORKS_API_TOKEN=<Bearer-токен сервисной учётки Works>
# Статическая cookie Works (формат "k1=v1; k2=v2"):
# WORKS_COOKIES=api_swtr_as21=true
# Код пространства AppSec (куда заводятся тикеты и где ищется компонент/версия):
# WORKS_SPACE=STS
# Проверять TLS Works (true — системный бандл; false — только тест; путь — PEM с CA):
# WORKS_VERIFY_SSL=true
# WORKS_TIMEOUT_SECONDS=30
# Шаблон ссылки на тикет Works ({key} — код, {space} — пространство):
# WORKS_ISSUE_URL_TEMPLATE=https://portal.works.prod.sbt/swtr/units/current/unit/{key}?space={space}&tenant=default
# Пути Works REST (без base — он из WORKS_BASE_URL). Меняйте только если API отличается:
# WORKS_UNIT_FIND_PATH=/rest/api/unit/v3/find
# WORKS_COMPONENT_FIND_PATH=/extension/plugin/v2/rest/api/sber_components_plugin/v1/component/find
# WORKS_VERSION_FIND_PATH=/extension/plugin/v2/rest/api/swtr_task_tracker_plugin/v1/version/find
# WORKS_CREATE_PATH=/rest/api/unit/v2/bug_appsec/create
# WORKS_UPLOAD_PATH=/rest/api/draft/files/v1/upload
