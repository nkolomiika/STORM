# ─────────────────────────────────────────────────────────────────────────────
# STORM — ШАБЛОН ПРОД-ОКРУЖЕНИЯ. Скопируйте в .env.prod и подставьте значения.
#   cp .env.prod.example .env.prod   &&   $EDITOR .env.prod
# .env.prod в git не попадает (см. .gitignore) — там реальные секреты.
# На существующей установке переносите ключи выборочно, сохраняя секреты.
# Пояснения и обязательные поля: docs/PROD_ENV.md.
# ─────────────────────────────────────────────────────────────────────────────
# Запуск:
#   dev :  docker compose up -d                                   (берёт .env)
#   prod:  ./deploy.sh                                            (берёт .env.prod)
#     └ то же вручную: ENV_FILE=.env.prod docker compose \
#           -f docker-compose.yml -f docker-compose.prod.yml up -d
# ─────────────────────────────────────────────────────────────────────────────

DATABASE_URL=postgresql+asyncpg://user:password@db:5432/storm

# ОБЯЗАТЕЛЬНО поменяйте: минимум 32 символа.
JWT_SECRET_KEY=
# ОБЯЗАТЕЛЬНЫЙ независимый ключ credentials/TOTP: случайный, минимум 32 символа.
# Должен отличаться от JWT_SECRET_KEY. Не используйте старый JWT как новый ключ.
DATA_ENCRYPTION_KEY=
# Только прежние независимые ключи данных, JSON-массив (до 5).
DATA_ENCRYPTION_PREVIOUS_KEYS=[]
# Дополнительные доверенные интеграции: только точные URL host:port для приложения.
# STORM_TRUSTED_EGRESS=[]
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=storm-files
MINIO_USE_SSL=false

# Публичный адрес сервера. По IP: https://<IP>. По домену: https://storm.example.com
# Добавили домен — впишите его и сюда, и в CSRF_ALLOWED_ORIGINS, иначе вход/POST → 403.
BACKEND_CORS_ORIGINS=https://storm.appsec.prod.sbt
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEBUG=false

COOKIE_SECURE=true
COOKIE_SAMESITE=strict
CSRF_ALLOWED_ORIGINS=https://storm.appsec.prod.sbt

# База для ссылок в письмах. Должна быть доступна ПОЛУЧАТЕЛЮ письма (не localhost).
APP_BASE_URL=https://storm.appsec.prod.sbt

# IAM уже разрешает https://storm.appsec.prod.sbt/auth/callback.
# Заполните SSO_ISSUER (либо SSO_METADATA_URL), SSO_CLIENT_ID и секрет клиента.
# Issuer — адрес IAM/realm, НЕ адрес STORM. Для публичного клиента secret пустой.
SSO_ENABLED=true
SSO_ISSUER=
SSO_METADATA_URL=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_SCOPES=openid profile email
SSO_REDIRECT_BASE=https://storm.appsec.prod.sbt
SSO_CALLBACK_PATH=/auth/callback
SSO_VERIFY_TLS=true
SSO_AUTO_CREATE_USERS=true
SSO_DEFAULT_ROLE=pentester

INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=CHANGE_ME

RABBITMQ_URL=amqp://guest:guest@rabbitmq/
MAIL_QUEUE_NAME=storm.mail
MAIL_ENABLED=false
MAIL_MAX_ATTEMPTS=5

# После настройки реального корпоративного SMTP включите MAIL_ENABLED=true.
SMTP_AUTH_METHOD=password
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=STORM
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

MAIL_PREVIEW_URL=


# TLS self-signed: адрес в SAN, чтобы сертификат соответствовал URL.
# По IP — заполните CERT_IP. По домену — CERT_HOST (CERT_IP оставьте пустым).
CERT_IP=
CERT_HOST=storm.appsec.prod.sbt

# Task Tracker / AS21. Заполните Bearer-токен сервисной учётки; cookie браузера не нужны.
WORKS_ENABLED=true
WORKS_BASE_URL=https://portal.works.prod.sbt/swtr
WORKS_API_TOKEN=
WORKS_COOKIES=api_swtr_as21=true
WORKS_VERIFY_SSL=true
WORKS_TIMEOUT_SECONDS=30
WORKS_SPACE=STS
WORKS_SUIT=bug_appsec
WORKS_TASKS_SPACE=APPSEC
WORKS_REFERENCE_SPACE=STS
WORKS_TENANT=default
WORKS_TASKS_SEARCH_PATH=/rest/api/unit/v3/find/tql
WORKS_TASKS_SEARCH_BODY='{"attributes":["workflow_status","priority","assigned_to","affects_version_s"],"calculatedAttributes":[],"query":"space = \"APPSEC\" and suit = \"security_assessment_appsec\"","page":{"size":20,"page":0},"timeZone":"Europe/Moscow"}'
WORKS_UNIT_DETAIL_PATH=/rest/api/unit/v2/{key}
WORKS_UNIT_FIND_PATH=/rest/api/unit/v3/find
WORKS_COMPONENT_FIND_PATH=/extension/plugin/v2/rest/api/sber_components_plugin/v1/component/find
WORKS_VERSION_FIND_PATH=/extension/plugin/v2/rest/api/swtr_task_tracker_plugin/v1/version/find
WORKS_PRODUCT_CODES_PATH=/rest/api/suit/v1/bug_appsec
WORKS_PRODUCT_CODES_ATTRIBUTE=product_code_list_sts
WORKS_CREATE_PATH=/rest/api/unit/v2/bug_appsec/create
WORKS_LINK_PATH=/rest/api/unit/v1/link
WORKS_LINK_TYPE=plain_connection
# Код продукта читается из value.code; если code атрибута отличается, задайте его здесь.
# Поиск по имени «Код продукта» поддержан для полной карточки.
WORKS_APPSEC_PRODUCT_CODE_ATTRIBUTE=product_code_list_sts
WORKS_APPSEC_COMPONENT_ATTRIBUTE=sber_component
WORKS_TASKS_DEMO_FILE=
